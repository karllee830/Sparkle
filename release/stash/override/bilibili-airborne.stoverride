name: Bilibili 空降助手
desc: 仅保留哔哩哔哩空降助手功能

rules:
  - DOMAIN,bsbsb.top,DIRECT

http:
  mitm:
    - grpc.biliapi.net
    - app.bilibili.com
  script:
    - match: '^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$'
      name: bilibili.airborne.request
      type: request
      require-body: true
      binary-mode: true
      timeout: 10
      argument: '{"logLevel":"1"}'
    - match: '^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.view(?:unite)?\.v1\.View\/ViewProgress$'
      name: bilibili.airborne.response
      type: response
      require-body: true
      binary-mode: true
      timeout: 10
      argument: '{"sponsorBlock":true,"logLevel":"1"}'

script-providers:
  bilibili.airborne.request:
    url: https://raw.githubusercontent.com/karllee830/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js?v=20260608-8560e56
    interval: 86400
  bilibili.airborne.response:
    url: https://raw.githubusercontent.com/karllee830/Sparkle/refs/heads/master/dist/bilibili.protobuf.response.js?v=20260608-8560e56
    interval: 86400
